# empty | fixture | mongodb
SHALOM_CONTENT_SOURCE=empty

# SHALOM_CONTENT_SOURCE=mongodb일 때만 필요
SHALOM_MONGODB_URI=
SHALOM_MONGODB_DB=shalom_house

# 로컬에서 최초 관리자 계정을 생성할 때만 일시적으로 사용합니다.
# Git 또는 Vercel에 실제 값을 저장하지 않습니다.
SHALOM_ADMIN_EMAIL=
SHALOM_ADMIN_PASSWORD=
SHALOM_ADMIN_NAME=
# 관리자 생성 시 생략하면 admin
SHALOM_ADMIN_ROLE=admin

# 활동사진 비공개 Supabase Storage
# Secret key는 서버에서만 사용하며 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
SHALOM_SUPABASE_URL=
SHALOM_SUPABASE_SECRET_KEY=
SHALOM_SUPABASE_GALLERY_PRIVATE_BUCKET=shalom-gallery-private
SHALOM_SUPABASE_DOCUMENTS_PRIVATE_BUCKET=shalom-documents-private
