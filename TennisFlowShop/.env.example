# MongoDB 연결 문자열과 기본 데이터베이스 이름은 동일한 DB를 가리켜야 합니다.
MONGODB_URI=
MONGODB_DB=tennis_academy

# 브라우저와 서버의 Supabase URL은 동일한 Project origin을 사용해야 합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Apps in Toss mTLS 인증서(.crt 파일 전체)의 Base64 인코딩 값
APPS_IN_TOSS_MTLS_CERT_BASE64=
# Apps in Toss mTLS private.key 파일 전체의 Base64 인코딩 값
APPS_IN_TOSS_MTLS_PRIVATE_KEY_BASE64=
# Toss가 제공한 Base64 AES-256 로그인 복호화 키
APPS_IN_TOSS_LOGIN_DECRYPTION_KEY=
# Toss가 제공한 로그인 복호화 AAD
APPS_IN_TOSS_LOGIN_AAD=
# Toss Pay 실행 환경: sandbox 또는 live
APPS_IN_TOSS_TOSS_PAY_ENV=
# Live 신규 결제 생성 허용 여부. 기본 false.
APPS_IN_TOSS_TOSS_PAY_LIVE_PREPARE_ENABLED=false
# Live 결제 승인 허용 여부. 기본 false.
APPS_IN_TOSS_TOSS_PAY_LIVE_EXECUTE_ENABLED=false
